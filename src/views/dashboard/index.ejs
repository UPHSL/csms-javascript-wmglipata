<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>CSMS Dashboard</title>
  <!-- Drop in Tailwind CSS for styling -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans leading-normal tracking-normal">
  
  <!-- Navigation -->
  <nav class="bg-blue-800 p-4 text-white shadow-lg">
    <div class="container mx-auto flex gap-6 items-center">
      <span class="font-bold tracking-wider text-xl mr-4">CSMS</span>
      <a href="/dashboard" class="hover:text-blue-300 transition">Dashboard</a>
      <a href="/residents" class="hover:text-blue-300 transition">Resident Management</a>
      <a href="/service-requests" class="hover:text-blue-300 transition">Service Request Management</a>
    </div>
  </nav>

  <div class="container mx-auto p-6 max-w-6xl">
    <h1 class="text-3xl font-extrabold mb-8 text-gray-800">CSMS Dashboard</h1>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
      
      <!-- Resident Metrics Card -->
      <div class="bg-white rounded-xl shadow-md p-6 border-t-4 border-blue-500">
        <h2 class="text-xl font-bold mb-6 text-gray-700">Resident Summary</h2>
        <div class="grid grid-cols-3 gap-4 text-center">
          <div class="bg-gray-50 p-4 rounded-lg shadow-sm border border-gray-100">
            <p class="text-xs text-gray-500 font-bold uppercase tracking-wider mb-1">Total</p>
            <p class="text-3xl font-black text-gray-800"><%= summary.residents.total %></p>
          </div>
          <div class="bg-gray-50 p-4 rounded-lg shadow-sm border border-gray-100">
            <p class="text-xs text-gray-500 font-bold uppercase tracking-wider mb-1">Active</p>
            <p class="text-3xl font-black text-green-600"><%= summary.residents.active %></p>
          </div>
          <div class="bg-gray-50 p-4 rounded-lg shadow-sm border border-gray-100">
            <p class="text-xs text-gray-500 font-bold uppercase tracking-wider mb-1">Inactive</p>
            <p class="text-3xl font-black text-red-500"><%= summary.residents.inactive %></p>
          </div>
        </div>
      </div>

      <!-- Service Request Metrics Card -->
      <div class="bg-white rounded-xl shadow-md p-6 border-t-4 border-indigo-500">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-xl font-bold text-gray-700">Service Request Summary</h2>
          <!-- Highlighted Open Metric -->
          <div class="bg-indigo-100 px-4 py-2 rounded-lg text-right border border-indigo-200">
            <p class="text-xs text-indigo-800 font-bold uppercase tracking-wider">Open Requests</p>
            <p class="text-2xl font-black text-indigo-700"><%= summary.serviceRequests.open %></p>
          </div>
        </div>
        
        <div class="grid grid-cols-5 gap-2 text-center">
          <div class="bg-gray-50 p-3 rounded-lg border border-gray-100">
            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-wide">Total</p>
            <p class="text-xl font-bold text-gray-800"><%= summary.serviceRequests.total %></p>
          </div>
          <div class="bg-gray-50 p-3 rounded-lg border border-gray-100">
            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-wide">Pending</p>
            <p class="text-xl font-bold text-yellow-600"><%= summary.serviceRequests.pending %></p>
          </div>
          <div class="bg-gray-50 p-3 rounded-lg border border-gray-100">
            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-wide">In Progress</p>
            <p class="text-xl font-bold text-blue-600"><%= summary.serviceRequests.inProgress %></p>
          </div>
          <div class="bg-gray-50 p-3 rounded-lg border border-gray-100">
            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-wide">Completed</p>
            <p class="text-xl font-bold text-green-600"><%= summary.serviceRequests.completed %></p>
          </div>
          <div class="bg-gray-50 p-3 rounded-lg border border-gray-100">
            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-wide">Cancelled</p>
            <p class="text-xl font-bold text-red-500"><%= summary.serviceRequests.cancelled %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Recent Service Requests Table -->
    <div class="bg-white rounded-xl shadow-md p-6">
      <h2 class="text-xl font-bold mb-6 text-gray-700">Five Most Recent Service Requests</h2>
      
      <!-- Empty State Requirement -->
      <% if (summary.recentRequests.length === 0) { %>
        <div class="bg-gray-50 border-2 border-dashed border-gray-200 rounded-lg p-8 text-center">
          <p class="text-gray-500 text-lg">No Service Requests available.</p>
        </div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-gray-50 text-gray-600 uppercase text-xs tracking-wider border-b-2 border-gray-200">
                <th class="py-4 px-6">ID</th>
                <th class="py-4 px-6">Res ID</th>
                <th class="py-4 px-6">Service Type</th>
                <th class="py-4 px-6">Date Requested</th>
                <th class="py-4 px-6">Status</th>
                <th class="py-4 px-6 text-center">Action</th>
              </tr>
            </thead>
            <tbody class="text-gray-700 text-sm">
              <% summary.recentRequests.forEach(req => { %>
                <tr class="border-b border-gray-100 hover:bg-indigo-50 transition">
                  <td class="py-4 px-6 font-medium"><%= req.id %></td>
                  <td class="py-4 px-6 text-gray-500"><%= req.residentId %></td>
                  <td class="py-4 px-6 font-bold text-gray-800"><%= req.serviceType %></td>
                  <td class="py-4 px-6 text-gray-600"><%= req.dateRequested %></td>
                  <td class="py-4 px-6">
                    <!-- Dynamic Status Badges -->
                    <span class="px-3 py-1 rounded-full text-xs font-bold 
                      <%= req.status === 'Pending' ? 'bg-yellow-100 text-yellow-700' : 
                          req.status === 'In Progress' ? 'bg-blue-100 text-blue-700' : 
                          req.status === 'Completed' ? 'bg-green-100 text-green-700' : 
                          'bg-red-100 text-red-700' %>">
                      <%= req.status %>
                    </span>
                  </td>
                  <td class="py-4 px-6 text-center">
                    <a href="/service-requests/<%= req.id %>" class="inline-block bg-indigo-600 text-white px-4 py-2 rounded-lg shadow-sm hover:bg-indigo-700 hover:shadow transition text-xs font-bold">
                      View Details
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

</body>
</html>