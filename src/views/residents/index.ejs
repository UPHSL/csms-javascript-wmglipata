<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Resident Management</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans leading-normal tracking-normal">

  <!-- Navigation -->
  <nav class="bg-blue-800 p-4 text-white shadow-lg">
    <div class="container mx-auto flex gap-6 items-center">
      <span class="font-bold tracking-wider text-xl mr-4">CSMS</span>
      <a href="/dashboard" class="hover:text-blue-300 transition">Dashboard</a>
      <a href="/residents" class="hover:text-blue-300 transition font-semibold underline underline-offset-4">Resident Management</a>
      <a href="/service-requests" class="hover:text-blue-300 transition">Service Request Management</a>
    </div>
  </nav>

  <div class="container mx-auto p-6 max-w-6xl">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-3xl font-extrabold text-gray-800">Resident Management</h1>
      <a href="/residents/register"
         class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-5 rounded-lg shadow-sm transition text-sm">
        + Register Resident
      </a>
    </div>

    <!-- Search Card -->
    <div class="bg-white rounded-xl shadow-md p-5 mb-6">
      <form method="GET" action="/residents" class="flex items-center gap-3">
        <input
          type="text"
          name="search"
          value="<%= search %>"
          placeholder="Search by name..."
          class="flex-1 border border-gray-300 rounded-lg px-4 py-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-400 transition"
        >
        <button
          type="submit"
          class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-5 rounded-lg shadow-sm transition text-sm">
          Search
        </button>
      </form>
    </div>

    <!-- Residents Table Card -->
    <div class="bg-white rounded-xl shadow-md p-6">
      <% if (residents.length === 0) { %>
        <div class="bg-gray-50 border-2 border-dashed border-gray-200 rounded-lg p-8 text-center">
          <p class="text-gray-500 text-lg">No Residents found.</p>
        </div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-gray-50 text-gray-600 uppercase text-xs tracking-wider border-b-2 border-gray-200">
                <th class="py-4 px-6">ID</th>
                <th class="py-4 px-6">Name</th>
                <th class="py-4 px-6">Address</th>
                <th class="py-4 px-6">Contact</th>
                <th class="py-4 px-6">Email</th>
                <th class="py-4 px-6">Status</th>
                <th class="py-4 px-6 text-center">Actions</th>
              </tr>
            </thead>
            <tbody class="text-gray-700 text-sm">
              <% residents.forEach(res => { %>
                <tr class="border-b border-gray-100 hover:bg-indigo-50 transition">
                  <td class="py-4 px-6 font-medium"><%= res.id %></td>
                  <td class="py-4 px-6 font-bold text-gray-800"><%= res.firstName %> <%= res.lastName %></td>
                  <td class="py-4 px-6 text-gray-600"><%= res.address %></td>
                  <td class="py-4 px-6 text-gray-600"><%= res.contactNumber %></td>
                  <td class="py-4 px-6 text-gray-600"><%= res.email %></td>
                  <td class="py-4 px-6">
                    <span class="px-3 py-1 rounded-full text-xs font-bold
                      <%= res.status === 'Active' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                      <%= res.status %>
                    </span>
                  </td>
                  <td class="py-4 px-6 text-center">
                    <div class="flex items-center justify-center gap-2">
                      <a href="/residents/<%= res.id %>/edit"
                         class="inline-block bg-indigo-600 text-white px-3 py-1.5 rounded-lg shadow-sm hover:bg-indigo-700 transition text-xs font-bold">
                        Edit
                      </a>
                      <% if (res.status === 'Active') { %>
                        <form method="POST" action="/residents/<%= res.id %>/deactivate" style="display:inline;">
                          <button type="submit"
                            class="bg-red-500 hover:bg-red-600 text-white px-3 py-1.5 rounded-lg shadow-sm transition text-xs font-bold">
                            Deactivate
                          </button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

</body>
</html>
